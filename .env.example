# Copy to .env and replace the placeholder values. Never commit .env.

# --- Docker Compose (database containers) ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=experiment_tracker
POSTGRES_PORT=5433
MONGO_PORT=27017

# --- Flask backend ---
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://tracker:change-me@localhost:5433/experiment_tracker
TEST_DATABASE_URL=postgresql+psycopg://tracker:change-me@localhost:5433/experiment_tracker_test
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=experiment_tracker
TEST_MONGO_DB_NAME=experiment_tracker_test
SECRET_KEY=replace-with-a-long-random-string
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
